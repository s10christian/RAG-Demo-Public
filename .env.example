APP_NAME=RAG Demo API
APP_ENV=development
LOG_LEVEL=INFO
API_V1_PREFIX=/api/v1

# Local PostgreSQL + pgvector (choose a strong password before starting)
POSTGRES_USER=rag
POSTGRES_PASSWORD=CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD
POSTGRES_DB=ragdb
DATABASE_URL=postgresql://rag:CHANGE_ME_TO_A_LONG_RANDOM_PASSWORD@db:5432/ragdb?sslmode=disable

# OpenAI-compatible embeddings and answer generation
OPENAI_API_KEY=
OPENAI_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_MODEL=gpt-4o-mini

# API authentication (generate a long random value)
RAG_API_KEY=
TENANT_ID=default

# Notion integration (optional)
NOTION_API_KEY=
NOTION_API_VERSION=2022-06-28

CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_TOP_K=5
MAX_TOP_K=20
MAX_UPLOAD_SIZE_MB=15

# Optional Telegram integration — leave blank unless configured
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_ALLOWED_CHAT_IDS=
